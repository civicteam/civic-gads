{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/configure_environment.py"
          },
          {
            "type": "command",
            "command": "python3 hooks/check_github_version.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "exit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/cleanup_environment.py"
          }
        ]
      }
    ]
  }
}
